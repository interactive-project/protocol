{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/interactive-project/protocol/blob/main/schemas/generation-catalog.v1.schema.json",
  "title": "Trusted exact-version generation catalog v1",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "1.0.0"
    },
    "catalogVersion": {
      "const": "1.0.0"
    },
    "entries": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "protocolVersion",
    "catalogVersion",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "declaration": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "requiredDrivers": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"
          }
        }
      },
      "required": [
        "supported"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "interactive": {
          "$ref": "#/$defs/declaration"
        },
        "evaluable": {
          "$ref": "#/$defs/declaration"
        },
        "collaborative": {
          "$ref": "#/$defs/declaration"
        },
        "offline": {
          "$ref": "#/$defs/declaration"
        },
        "deterministic": {
          "$ref": "#/$defs/declaration"
        },
        "resumable": {
          "$ref": "#/$defs/declaration"
        },
        "aiGeneratable": {
          "$ref": "#/$defs/declaration"
        }
      },
      "required": [
        "interactive",
        "evaluable",
        "collaborative",
        "offline",
        "deterministic",
        "resumable",
        "aiGeneratable"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "interactive-project/quiz",
            "interactive-project/flashcards",
            "interactive-project/code",
            "interactive-project/simulation",
            "interactive-project/diagram",
            "interactive-project/whiteboard"
          ]
        },
        "activitySchemaVersion": {
          "type": "string",
          "description": "Three-part non-negative version of this type's config schema.",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "schemaId": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "requiredCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 7,
          "items": {
            "enum": [
              "interactive",
              "evaluable",
              "collaborative",
              "offline",
              "deterministic",
              "resumable",
              "aiGeneratable"
            ]
          }
        },
        "requiredPermissions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "enum": [
              "network",
              "execution",
              "media"
            ]
          }
        }
      },
      "required": [
        "type",
        "activitySchemaVersion",
        "schemaId",
        "capabilities",
        "requiredCapabilities",
        "requiredPermissions"
      ],
      "additionalProperties": false
    }
  }
}
