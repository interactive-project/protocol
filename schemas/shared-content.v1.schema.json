{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json",
  "title": "Shared content, localization, accessibility and asset references v1",
  "oneOf": [
    {
      "$ref": "#/$defs/contentRef"
    },
    {
      "$ref": "#/$defs/localizedText"
    },
    {
      "$ref": "#/$defs/accessibility"
    },
    {
      "$ref": "#/$defs/assetRef"
    }
  ],
  "$defs": {
    "contentRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "content-ref"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri"
        },
        "plainText": {
          "$ref": "#/$defs/localizedText"
        },
        "accessibility": {
          "$ref": "#/$defs/accessibility"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "id",
        "plainText"
      ],
      "additionalProperties": false
    },
    "localizedText": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "localized-text"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "defaultLocale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "translations": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "direction": {
                "enum": [
                  "ltr",
                  "rtl",
                  "auto"
                ]
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "defaultLocale",
        "translations"
      ],
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "accessibility"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "instructions": {
          "$ref": "#/$defs/localizedText"
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "equivalentExperience": {
          "$ref": "#/$defs/localizedText"
        }
      },
      "required": [
        "kind",
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    "assetRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "asset-ref"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri"
        },
        "mediaType": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri"
        },
        "integrity": {
          "type": "object",
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        "attribution": {
          "type": "object",
          "properties": {
            "creator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "format": "uri"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "format": "uri"
            }
          },
          "required": [
            "creator"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "id",
        "mediaType"
      ],
      "additionalProperties": false
    }
  }
}
