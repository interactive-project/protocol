{
  "name": "@interactive-project/protocol",
  "version": "0.1.0",
  "type": "module",
  "description": "Portable ActivitySpec JSON Schema and validation diagnostics",
  "files": [
    "schemas",
    "validation",
    "types",
    "docs",
    "fixtures",
    "README.md",
    "content",
    "interoperability",
    "generation",
    "catalogs",
    "evolution"
  ],
  "exports": {
    "./schemas/activity-spec.v1.schema.json": "./schemas/activity-spec.v1.schema.json",
    "./schemas/validation-result.v1.schema.json": "./schemas/validation-result.v1.schema.json",
    "./validation": {
      "types": "./validation/index.d.ts",
      "import": "./validation/index.js",
      "default": "./validation/index.js"
    },
    "./types": "./types/activity-spec.d.ts",
    "./content": {
      "types": "./content/index.d.ts",
      "import": "./content/index.js",
      "default": "./content/index.js"
    },
    "./validation/shared-content": {
      "types": "./validation/shared-content.d.ts",
      "import": "./validation/shared-content.js",
      "default": "./validation/shared-content.js"
    },
    "./schemas/shared-content.v1.schema.json": "./schemas/shared-content.v1.schema.json",
    "./interoperability": {
      "types": "./interoperability/index.d.ts",
      "import": "./interoperability/index.js",
      "default": "./interoperability/index.js"
    },
    "./validation/interoperability": {
      "types": "./validation/interoperability.d.ts",
      "import": "./validation/interoperability.js",
      "default": "./validation/interoperability.js"
    },
    "./schemas/interoperability.v1.schema.json": "./schemas/interoperability.v1.schema.json",
    "./generation": {
      "types": "./generation/index.d.ts",
      "import": "./generation/index.js",
      "default": "./generation/index.js"
    },
    "./schemas/generation-catalog.v1.schema.json": "./schemas/generation-catalog.v1.schema.json",
    "./catalogs/available-generation.v1.json": "./catalogs/available-generation.v1.json",
    "./generation/json": {
      "types": "./generation/json.d.ts",
      "import": "./generation/json.js",
      "default": "./generation/json.js"
    },
    "./evolution": {
      "types": "./evolution/index.d.ts",
      "import": "./evolution/index.js",
      "default": "./evolution/index.js"
    },
    "./catalogs/compatibility.v1.json": "./catalogs/compatibility.v1.json",
    "./catalogs/conformance-plan.v1.json": "./catalogs/conformance-plan.v1.json"
  },
  "scripts": {
    "test": "node scripts/check-conformance.mjs && python3 scripts/check_conformance.py && node scripts/check-shared-content.mjs && python3 scripts/check_shared_content.py && node scripts/check-interoperability.mjs && python3 scripts/check_interoperability.py && node scripts/check-generation.mjs && python3 scripts/check_generation.py && node scripts/check-evolution.mjs",
    "check:types": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext types/activity-spec.d.ts validation/index.d.ts scripts/type-consumer.mts content/index.d.ts validation/shared-content.d.ts scripts/shared-content-consumer.mts interoperability/index.d.ts validation/interoperability.d.ts scripts/interoperability-consumer.mts generation/index.d.ts scripts/generation-consumer.mts"
  },
  "peerDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "ajv-formats": {
      "optional": true
    }
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3"
  }
}
